if not dr_subnets:
raise RuntimeError(
"No DR subnets found (dr_application_subnets['Subnets'] is empty). "
"Fix the DR subnet filters (describe_subnets) so it returns the DR application subnets."
)

# --- index DR subnets by AZ letter suffix ---
dr_by_letter = {}
for s in dr_subnets:
dr_az = str(s.get("AvailabilityZone", ""))
subnet_id = s.get("SubnetId")
if not dr_az or not subnet_id:
continue
letter = dr_az[-1] # a/b/c
dr_by_letter.setdefault(letter, []).append(s)

