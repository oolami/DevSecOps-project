
# Confirm exactly one intended target was discovered.
if (@($matches).Count -ne 1) {
    throw "Expected exactly one matching NSX-ALB certificate object."
}

$targetCert = @($matches)[0]

if ($targetCert.name -ne $certObjectName) {
    throw "NSX-ALB target name mismatch."
}

if ([string]::IsNullOrWhiteSpace($targetCert.uuid)) {
    throw "Target certificate UUID is missing."
}

# Load the issued certificate.
$issuedCert = [System.Security.Cryptography.X509Certificates.X509Certificate2]::new(
    $leafPath
)

# Validate that the downloaded certificate has the expected DNS identity.
$dnsNames = @(
    $issuedCert.Extensions |
    Where-Object { $_.Oid.Value -eq "2.5.29.17" } |
    ForEach-Object { $_.Format($true) }
)

if (-not ($dnsNames -match "sentry\.silacins\.com")) {
    throw "Issued certificate does not appear to contain the expected DNS identity."
}

# Prepare the NSX-ALB certificate payload.
$certificatePem = Get-Content -LiteralPath $leafPath -Raw

if ($certificatePem -notmatch "-----BEGIN CERTIFICATE-----") {
    throw "Downloaded certificate is not PEM formatted."
}

$payload = @{
    certificate = @{
        certificate = $certificatePem
    }
}

$payloadJson = $payload | ConvertTo-Json -Depth 10

$uploadUri = "$nsxHost/api/sslkeyandcertificate/$($targetCert.uuid)"

Write-Host "NSX-ALB upload preparation:"
Write-Host "Target object: $($targetCert.name)"
Write-Host "Target UUID: $($targetCert.uuid)"
Write-Host "Certificate subject: $($issuedCert.Subject)"
Write-Host "Certificate expiration: $($issuedCert.NotAfter)"
Write-Host "Upload method: PATCH"
Write-Host "Upload endpoint: /api/sslkeyandcertificate/<target-uuid>"

if ($dryRun) {
    Write-Host "DRY RUN: Upload request prepared."
    Write-Host "DRY RUN: No NSX-ALB modification performed."
    Write-Host "DRY RUN: Certificate/private-key match must be verified before live upload."
    return
}

throw "Live upload is intentionally disabled pending verification of the target object's private key and the NSX-ALB update API contract."
