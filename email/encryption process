$services = @(
    "wholeshestack_bravo_apas-internal-api",
    "wholeshestack_bravo_windapi",
    "wholeshestack_bravo_portal-api"
)

foreach ($service in $services) {
    Write-Host "`nService: $service"

    docker service inspect $service `
        --format '{{json .Spec.TaskTemplate.ContainerSpec.Env}}' |
        ConvertFrom-Json |
        ForEach-Object { ($_ -split '=', 2)[0] }
}

























$services = @(
    "wholeshestack_bravo_admin-api",
    "wholeshestack_bravo_portal-api"
)

foreach ($service in $services) {
    Write-Host "`nService: $service"

    docker service inspect $service `
        --format '{{json .Spec.TaskTemplate.ContainerSpec.Configs}}' |
        ConvertFrom-Json |
        Select-Object ConfigName,
            @{Name='Target';Expression={$_.File.Name}}
}






docker service inspect wholeshestack_bravo_admin --format '{{json .Spec.TaskTemplate.ContainerSpec.Env}}' |
ConvertFrom-Json |
Where-Object { $_ -match 'API|URL|HOST|ENDPOINT' }