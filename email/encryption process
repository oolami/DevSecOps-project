$searchPaths = @(
    $env:TEAMCITY_BUILD_CHECKOUTDIR,
    $env:TEAMCITY_BUILD_TEMP_DIR,
    $env:TEAMCITY_BUILD_WORKING_DIR
) | Where-Object { $_ -and (Test-Path $_) } |
    Select-Object -Unique

$files = @(
    foreach ($path in $searchPaths) {
        Get-ChildItem -Path $path `
            -Filter "DigiCertCA.crt" `
            -Recurse -File `
            -ErrorAction SilentlyContinue
    }
) | Sort-Object -Property FullName -Unique











$ErrorActionPreference = "Stop"

$commonName = "%CommonName%"
$dryRun = "%DryRun%"
$required = "%FastlyDeploymentRequired%"
$token = $env:FASTLY_API_TOKEN

if ($required -ne "true") {
    Write-Host "Fastly deployment not required."
    exit 0
}

if ([string]::IsNullOrWhiteSpace($token)) {
    throw "FASTLY_API_TOKEN is missing."
}

$headers = @{
    "Fastly-Key" = $token
    "Accept" = "application/vnd.api+json"
    "Content-Type" = "application/vnd.api+json"
}

# Locate the exact required DigiCert artifact.
$files = @(
    Get-ChildItem -Path $env:TEAMCITY_BUILD_CHECKOUTDIR `
        -Filter "DigiCertCA.crt" -Recurse -File `
        -ErrorAction SilentlyContinue
)

if ($files.Count -ne 1) {
    throw "Expected exactly one DigiCertCA.crt in checkout; found $($files.Count)."
}

$certPath = $files[0].FullName
$certPem = [System.IO.File]::ReadAllText($certPath)

if ($certPem -notmatch "-----BEGIN CERTIFICATE-----") {
    throw "DigiCertCA.crt is not PEM-formatted."
}

# Read the first certificate in the PEM file.
$match = [regex]::Match(
    $certPem,
    "(?s)-----BEGIN CERTIFICATE-----\s*(.*?)\s*-----END CERTIFICATE-----"
)

if (-not $match.Success) {
    throw "No certificate block found."
}

$certBytes = [Convert]::FromBase64String(
    ($match.Groups[1].Value -replace "\s", "")
)

$newCert = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2 -ArgumentList @(,$certBytes)

if ($newCert.NotAfter -le (Get-Date)) {
    throw "Replacement certificate is expired."
}

# Read replacement certificate DNS names.
function Get-CertNames($cert) {
    $names = @()

    foreach ($extension in $cert.Extensions) {
        if ($extension.Oid.Value -eq "2.5.29.17") {
            $formatted = $extension.Format($false)
            $names += @(
                [regex]::Matches(
                    $formatted,
                    "DNS Name\s*=\s*([^,\r\n]+)"
                ) | ForEach-Object {
                    $_.Groups[1].Value.Trim().ToLowerInvariant()
                }
            )
        }
    }

    if ($names.Count -eq 0) {
        $names += $cert.GetNameInfo(
            [System.Security.Cryptography.X509Certificates.X509NameType]::DnsName,
            $false
        ).ToLowerInvariant()
    }

    return @($names | Sort-Object -Unique)
}

$newNames = @(Get-CertNames $newCert)

if ($newNames -notcontains $commonName.ToLowerInvariant()) {
    throw "DigiCertCA.crt does not explicitly contain $commonName."
}

Write-Host "Replacement certificate: $certPath"
Write-Host "Replacement expires: $($newCert.NotAfter)"
Write-Host "Replacement DNS names: $($newNames -join ', ')"

# Discover the existing Fastly certificate.
$uri = "https://api.fastly.com/tls/certificates"
$allCerts = @()

do {
    $response = Invoke-RestMethod -Uri $uri `
        -Headers $headers -Method GET

    $allCerts += @($response.data | Where-Object { $_ })

    $next = $response.links.next
    if ($next -and $next -notmatch "^https?://") {
        $next = [Uri]::new(
            [Uri]$uri, [string]$next
        ).AbsoluteUri
    }

    $uri = $next
} while ($uri)

$matches = @(
    $allCerts | Where-Object {
        $domains = @(
            $_.relationships.tls_domains.data |
            ForEach-Object { $_.id }
        )

        $domains -contains $commonName
    }
)

if ($matches.Count -ne 1) {
    throw "Expected one Fastly certificate for $commonName; found $($matches.Count)."
}

$existing = $matches[0]
$certificateId = $existing.id

$existingDomains = @(
    $existing.relationships.tls_domains.data |
    ForEach-Object { $_.id.ToLowerInvariant() } |
    Sort-Object -Unique
)

# Fail closed if replacement does not cover existing domains.
function Test-Coverage($hostname, $names) {
    foreach ($name in $names) {
        if ($hostname -eq $name) { return $true }

        if ($name.StartsWith("*.")) {
            $suffix = $name.Substring(2)
            if ($hostname.EndsWith(".$suffix")) {
                $prefix = $hostname.Substring(
                    0,
                    $hostname.Length - $suffix.Length - 1
                )
                if ($prefix -and -not $prefix.Contains(".")) {
                    return $true
                }
            }
        }
    }
    return $false
}

$missing = @(
    $existingDomains | Where-Object {
        -not (Test-Coverage $_ $newNames)
    }
)

Write-Host "Existing Fastly certificate ID: $certificateId"
Write-Host "Existing TLS domains: $($existingDomains -join ', ')"

if ($missing.Count -gt 0) {
    throw "UPDATE BLOCKED: DigiCertCA.crt does not cover existing Fastly domains: $($missing -join ', ')"
}

# Update existing certificate; never create a new one.
$updateUri = "https://api.fastly.com/tls/certificates/$certificateId"

$payload = @{
    data = @{
        type = "tls_certificate"
        attributes = @{
            cert_blob = $certPem
        }
    }
} | ConvertTo-Json -Depth 10

if ($dryRun -eq "true") {
    Write-Host "DRY RUN: Existing certificate validated."
    Write-Host "Would PATCH existing Fastly certificate: $certificateId"
    Write-Host "No Fastly changes made."
    exit 0
}

if ($dryRun -ne "false") {
    throw "Invalid DryRun value: $dryRun"
}

Write-Host "Updating existing Fastly certificate..."

$result = Invoke-RestMethod `
    -Uri $updateUri `
    -Method PATCH `
    -Headers $headers `
    -Body $payload

if ($result.data.id -ne $certificateId) {
    throw "Unexpected certificate ID in Fastly response."
}

# Verify the update by reading the certificate resource.
$verified = Invoke-RestMethod `
    -Uri $updateUri `
    -Method GET `
    -Headers $headers

if ($verified.data.id -ne $certificateId) {
    throw "Post-deployment verification failed."
}

Write-Host "FASTLY CERTIFICATE UPDATE SUCCESSFUL"
Write-Host "Certificate ID: $certificateId"
Write-Host "Expires: $($verified.data.attributes.not_after)"
