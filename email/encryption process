$configs = @{
    "apas-external-api" = "wholeshestack_pre_prod_apas-external-api-9480adb9"
    "apas-internal-api" = "wholeshestack_pre_prod_apas-internal-api-cf42c6f0"
    "portal-api" = "wholeshestack_pre_prod_portal-api-5d7a8231"
}

foreach ($name in $configs.Keys) {

    $configName = $configs[$name]

    $config = docker config inspect $configName |
        ConvertFrom-Json

    $bytes = [byte[]]$config.Spec.Data

    $json = [System.Text.Encoding]::UTF8.GetString($bytes)

    $json | ConvertFrom-Json -ErrorAction Stop | Out-Null

    $filePath = "$HOME\preprod-$name.json"

    $json | Set-Content $filePath -Encoding utf8

    Write-Host "Successfully saved: $filePath"
}











