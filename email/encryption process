Write-Host "Checking Fastly TLS domains..."

$domainsResponse = Invoke-RestMethod `
    -Uri "https://api.fastly.com/tls/domains" `
    -Method GET `
    -Headers $headers

$domains = @($domainsResponse.data)

Write-Host "TLS domains returned: $($domains.Count)"

$matches = @(
    $domains | Where-Object {
        $_.attributes.name -eq "sentry.silacins.com"
    }
)

Write-Host "Matching TLS domains: $($matches.Count)"

foreach ($match in $matches) {
    Write-Host "TLS Domain ID: $($match.id)"
    Write-Host "Domain: $($match.attributes.name)"
}