$CertificateType = "%CertificateType%".Trim()

if ($CertificateType -eq "External") {
    Write-Host "External certificate workflow detected."
    Write-Host "NSX-ALB CSR generation is not applicable."
    Write-Host "External CSR and private key handling must be configured before proceeding."
    throw "External CSR generation is not configured."
}

if ($CertificateType -ne "Internal") {
    throw "Unsupported CertificateType: $CertificateType"
}

