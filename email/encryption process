# Validate requested hostnames against SANs.
$expectedNames = @(
    $commonName,
    "www.$commonName"
)

$sanExtension = $leaf.Extensions |
    Where-Object { $_.Oid.Value -eq "2.5.29.17" }

if (-not $sanExtension) {
    throw "Server certificate has no SAN extension."
}

$sanText = $sanExtension.Format($false)

$dnsNames = @(
    [regex]::Matches(
        $sanText,
        '(?i)DNS(?: Name)?\s*[:=]\s*([^,\r\n]+)'
    ) | ForEach-Object {
        $_.Groups[1].Value.Trim()
    }
)

Write-Host "Validated SAN names: $($dnsNames -join ', ')"








$expectedNames = @(
    $commonName,
    "www.$commonName"
)

foreach ($name in $expectedNames) {
    if ($name -notin $dnsNames) {
        throw "Certificate SAN does not include $name"
    }
}

Write-Host "Certificate SAN validation passed: $($dnsNames -join ', ')"






$workingDir = Join-Path $env:TEMP "DigiCertCertificate"
New-Item -ItemType Directory -Path $workingDir -Force | Out-Null