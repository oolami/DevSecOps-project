$encoded = Get-Content "$HOME\Documents\encoded-key.txt" -Raw


[System.IO.File]::WriteAllBytes(
    "$env:TEMP\nasdaq_private_key",
    [Convert]::FromBase64String($encoded.Trim())
)





notepad "$env:TEMP\nasdaq_private_key"





Get-ChildItem $HOME -Recurse -Filter "encoded-key.txt" -ErrorAction SilentlyContinue






Get-Content "$env:TEMP\nasdaq_private_key" -First 1