set -eu
set -o pipefail

case "%Environment%" in
  dev)
    SQL_SERVER_NAME="%sqlServerNameDev%"
    ;;
  pre-prod)
    SQL_SERVER_NAME="%sqlServerNamePreProd%"
    ;;
  *)
    echo "ERROR: Unsupported environment" >&2
    exit 1
    ;;
esac





jq -n --arg sqlServerName "$SQL_SERVER_NAME" '{
  environmentName: "%Environment%",
  sqlServerName: $sqlServerName,




}' > cypress.env.json






Thanks, Alex. That makes sense. Since the Admin build inherits steps that still reference %Environment%, I’ll keep it mapped internally to %environmentName% and hide it from the Run Custom Build dialog so we only have one environment selection.

I’ll also check whether the legacy SqlServerName parameter is still referenced before hiding it locally. That should preserve compatibility without changing the shared template.








