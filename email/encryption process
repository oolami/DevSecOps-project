$certificateType = "%CertificateType%".Trim()

if ($certificateType -eq "External") {

    $targetCertName = "%NSXCertificateObjectName%".Trim()

    if ([string]::IsNullOrWhiteSpace($targetCertName)) {
        throw "NSXCertificateObjectName is required for external certificates."
    }

    $encodedName = [System.Uri]::EscapeDataString($targetCertName)

    $certResponse = Invoke-RestMethod `
        -Uri "%NSX-ALB-Host%/api/sslkeyandcertificate?name=$encodedName" `
        -WebSession $session `
        -Headers $headers `
        -Method GET

    $matches = @($certResponse.results | Where-Object {
        $_.name -eq $targetCertName
    })

    if ($matches.Count -ne 1) {
        throw "Expected exactly one NSX-ALB certificate named '$targetCertName'; found $($matches.Count)."
    }

    $targetCert = $matches[0]
    $expectedCertRef = $targetCert.url

    if ($dryRun) {
        Write-Host "DRY RUN - VERIFY EXTERNAL VS CERTIFICATE"
        Write-Host "Virtual Service: $virtualService"
        Write-Host "Expected certificate: $targetCertName"
        Write-Host "Expected certificate UUID: $($targetCert.uuid)"
        Write-Host "No certificate assignment was changed."
        exit 0
    }

    if ($currentRefs -notcontains $expectedCertRef) {
        throw "External certificate verification failed. '$targetCertName' is not assigned to '$virtualService'."
    }

    Write-Host "EXTERNAL CERTIFICATE VERIFICATION SUCCESSFUL"
    Write-Host "Virtual Service: $virtualService"
    Write-Host "Certificate: $targetCertName"
    Write-Host "Certificate UUID: $($targetCert.uuid)"
    exit 0
}