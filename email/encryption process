if ($caPemBlocks.Count -gt 0) {
    $intermediates = $caPemBlocks





$fullChainPem = (@($leafPem) + $caPemBlocks) -join "`n"
Set-Content -Path $bundlePath -Value $fullChainPem -Encoding ascii




# Identify the server certificate from the downloaded bundle.
# Do not assume the first PEM block is the leaf certificate.

$leaf = $null
$leafPem = $null
$caPemBlocks = @()

foreach ($block in $blocks) {
    $cert = [System.Security.Cryptography.X509Certificates.X509Certificate2]::CreateFromPem(
        $block.Value
    )

    $sanNames = @(
        $cert.DnsNameList | ForEach-Object { $_.Unicode }
    )

    if ($commonName -in $sanNames) {
        if ($null -ne $leaf) {
            throw "Multiple certificates match $commonName."
        }

        $leaf = $cert
        $leafPem = $block.Value
    }
    else {
        $caPemBlocks += $block.Value
    }
}

if ($null -eq $leaf) {
    throw "No server certificate found for $commonName in DigiCert bundle."
}

Write-Host "Server certificate identified."
Write-Host "Certificate subject: $($leaf.Subject)"
Write-Host "Certificate issuer: $($leaf.Issuer)"
Write-Host "Certificate thumbprint: $($leaf.Thumbprint)"
Write-Host "DNS names detected:"

foreach ($dns in $leaf.DnsNameList) {
    Write-Host " - $($dns.Unicode)"
}
