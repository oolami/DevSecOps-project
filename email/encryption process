
# Discover the specified NSX-ALB certificate object
$uri = "$nsxHost/api/sslkeyandcertificate?page_size=200"
$matches = @()

do {
    $response = Invoke-RestMethod `
        -Uri $uri `
        -Method GET `
        -Headers $headers `
        -WebSession $session

    $matches += @(
        $response.results | Where-Object {
            $_.name -eq $certObjectName
        }
    )

    $uri = $response.next

    if ($uri -and $uri.StartsWith("/")) {
        $uri = "$nsxHost$uri"
    }

} while ($uri)

Write-Host "Requested NSX certificate object: $certObjectName"
Write-Host "Matching NSX-ALB certificate objects: $($matches.Count)"

foreach ($cert in $matches) {
    Write-Host "Name: $($cert.name)"
    Write-Host "UUID: $($cert.uuid)"
    Write-Host "Type: $($cert.type)"
    Write-Host "Certificate present: $(-not [string]::IsNullOrWhiteSpace($cert.certificate.certificate))"
}

if ($matches.Count -ne 1) {
    throw "Expected exactly one matching NSX-ALB certificate object. Found $($matches.Count)."
}

Write-Host "DRY RUN: NSX-ALB certificate discovery succeeded."
Write-Host "No certificate was uploaded or modified."
