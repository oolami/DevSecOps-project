$ErrorActionPreference = "Stop"

$nsxHost     = "%NSX-ALB-Host%"
$nsxVersion  = "%NSX-ALB-Version%"
$username    = "%NSX-ALB-Username%"
$password    = "%NSX-ALB-Password%"
$commonName  = "%CommonName%"
$dryRun      = "%DryRun%"

Write-Host "========================================="
Write-Host "NSX-ALB Certificate Discovery"
Write-Host "Common Name : $commonName"
Write-Host "Dry Run     : $dryRun"
Write-Host "========================================="

$headers = @{
    "Content-Type"  = "application/json"
    "x-avi-version" = $nsxVersion
}

$signInBody = @"
{
    "username": "$username",
    "password": "$password"
}
"@

# Login
$signInResponse = Invoke-WebRequest `
    "$nsxHost/login" `
    -SessionVariable session `
    -Method POST `
    -Headers $headers `
    -Body $signInBody

if ($signInResponse.StatusCode -ne 200) {
    throw "NSX-ALB sign in failed."
}

Write-Host "Successfully authenticated to NSX-ALB."

# Add CSRF headers using same pattern as existing TeamCity scripts
$csrfCookie = $session.Cookies.GetAllCookies() |
    Where-Object { $_.Name -eq "csrftoken" } |
    Select-Object -First 1

if ($csrfCookie) {
    $headers["X-CSRFToken"] = $csrfCookie.Value
}

$headers["Referer"] = $nsxHost

# Read-only lookup
$uri = "$nsxHost/api/sslkeyandcertificate"

$response = Invoke-WebRequest `
    $uri `
    -WebSession $session `
    -Method GET `
    -Headers $headers

if ($response.StatusCode -ne 200) {
    throw "Failed to retrieve NSX-ALB certificates."
}

$data = $response.Content | ConvertFrom-Json

$matches = @(
    $data.results | Where-Object {
        $_.name -like "*$commonName*" -or
        $_.certificate.subject.common_name -eq $commonName
    }
)

Write-Host "Matching certificate objects found: $($matches.Count)"

if ($matches.Count -eq 0) {
    Write-Warning "No matching certificate was found for $commonName."
}
else {
    foreach ($cert in $matches) {
        Write-Host "-----------------------------------------"
        Write-Host "Certificate Name : $($cert.name)"
        Write-Host "UUID             : $($cert.uuid)"
        Write-Host "Type             : $($cert.type)"

        if ($cert.certificate) {
            Write-Host "Common Name      : $($cert.certificate.subject.common_name)"
            Write-Host "Issuer           : $($cert.certificate.issuer)"
        }
    }
}

Write-Host "-----------------------------------------"
Write-Host "Discovery completed successfully."
Write-Host "No NSX-ALB changes were made."
