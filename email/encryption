const updateEnvReservation = async (envName: string, reservation: EnvReservation): Promise<boolean> => {
  try {
    const data = JSON.stringify(reservation)
    await client.set(
      `${envReservationPrefix}${envName}`,
      data,
      "KEEPTTL"
    )
    return true
  } catch (e) {
    logger.error("failed to update env reservation for %s %O", envName, e)
    return false
  }
}





if (await redisApi.updateEnvReservation(env, { ...reservation, lastReminderAtTs: now })) {
  logger.info("Updated lastReminderAtTs for %s and sending notification to %s", env, reservation.userName)

  await sendMsTeamsMessage(
    reservation.userName,
    reservation.reservedAtTs,
    env
  )
} else {
  logger.warn("Failed to update lastReminderAtTs for %s", env)
}
