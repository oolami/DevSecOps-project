$ErrorActionPreference = 'Stop'

$dryRun = "%DryRun%".Trim().ToLower() -eq "true"
$virtualService = "%VirtualService%"

Write-Host "Virtual Service: $virtualService"
Write-Host "Dry Run: $dryRun"

# Login to NSX-ALB
$headers = @{
    "Content-Type"  = "application/json"
    "X-Avi-Version" = "%NSX-ALB-Version%"
}

$signInBody = @{
    username = "%NSX-ALB-Username%"
    password = "%NSX-ALB-Password%"
} | ConvertTo-Json

$signInResponse = Invoke-WebRequest `
    "%NSX-ALB-Host%/login" `
    -SessionVariable session `
    -Method POST `
    -Headers $headers `
    -Body $signInBody

if ($signInResponse.StatusCode -ne 200) {
    throw "NSX-ALB login failed."
}

$headers["X-CSRFToken"] = $session.Cookies.GetAllCookies()["csrftoken"].Value
$headers["Referer"] = "%NSX-ALB-Host%/"

# Find selected Virtual Service
$vsResponse = Invoke-RestMethod `
    "%NSX-ALB-Host%/api/virtualservice?name=$virtualService" `
    -WebSession $session `
    -Headers $headers

if (-not $vsResponse.results -or $vsResponse.results.Count -eq 0) {
    throw "Virtual Service '$virtualService' was not found."
}

$vs = $vsResponse.results[0]

Write-Host "Found Virtual Service: $($vs.name)"

# Find certificate uploaded by Step 5
$certUuid = Get-Content "%teamcity.build.id%.json" | jq -r '.uuid'

if (-not $certUuid) {
    throw "Unable to determine uploaded certificate UUID."
}

$newCertRef = "%NSX-ALB-Host%/api/sslkeyandcertificate/$certUuid"

Write-Host "New certificate UUID: $certUuid"

# Show current certificate
Write-Host "Current certificate reference(s):"
$vs.ssl_key_and_certificate_refs | ForEach-Object {
    Write-Host "  $_"
}

Write-Host "New certificate reference:"
Write-Host "  $newCertRef"

if ($dryRun) {
    Write-Host "=========================================="
    Write-Host "DRY RUN - REPLACE VS CERTIFICATE"
    Write-Host "Would update: $virtualService"
    Write-Host "Would remove current RSA certificate."
    Write-Host "Would attach certificate UUID: $certUuid"
    Write-Host "No NSX-ALB changes were made."
    Write-Host "=========================================="
    exit 0
}

# Replace old certificate with new certificate
$vs.ssl_key_and_certificate_refs = @($newCertRef)

$body = $vs | ConvertTo-Json -Depth 20

Invoke-RestMethod `
    "$($vs.url)" `
    -WebSession $session `
    -Method PUT `
    -Headers $headers `
    -Body $body

Write-Host "Certificate successfully replaced on $virtualService"






$certResult = Get-Content "%teamcity.build.id%.json" -Raw | ConvertFrom-Json
$certUuid = $certResult.uuid





