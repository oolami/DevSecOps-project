$ErrorActionPreference = "Stop"

$operation       = "%Operation%"
$certificateType = "%CertificateType%"
$commonName      = "%CommonName%"
$dryRun          = "%DryRun%"

$validOperations = @(
    "Renew",
    "Reissue",
    "NewOrder",
    "DeployOnly"
)

$validTypes = @(
    "Internal",
    "External"
)

Write-Host "Certificate workflow validation"
Write-Host "Operation       : $operation"
Write-Host "CertificateType : $certificateType"
Write-Host "CommonName      : $commonName"
Write-Host "DryRun          : $dryRun"

if ($operation -notin $validOperations) {
    throw "Invalid Operation: $operation"
}

if ($certificateType -notin $validTypes) {
    throw "Invalid CertificateType: $certificateType"
}

if ([string]::IsNullOrWhiteSpace($commonName)) {
    throw "CommonName is required."
}

if ($operation -eq "Renew" -and "%RotatePrivateKey%" -eq "true") {
    Write-Warning "Private key rotation requested for a renewal."
}

Write-Host "Input validation completed successfully."







$commonNameEncoded = [uri]::EscapeDataString("%CommonName%")

$uri = "%NSX-ALB-Host%/api/sslkeyandcertificate?name=$commonNameEncoded"

$response = Invoke-WebRequest `
    -Uri $uri `
    -WebSession $session `
    -Headers $headers `
    -Method GET

if ($response.StatusCode -ne 200) {
    throw "Failed to query NSX-ALB certificate objects."
}

$data = $response.Content | ConvertFrom-Json

Write-Host "Matching certificate objects found: $($data.count)"

if ($data.count -gt 0) {

    foreach ($cert in $data.results) {

        Write-Host "Certificate name: $($cert.name)"
        Write-Host "UUID            : $($cert.uuid)"
        Write-Host "Type            : $($cert.type)"
    }

    Write-Host "Existing NSX-ALB certificate object found."
}
else {

    Write-Host "No existing certificate object found for %CommonName%."

    if ("%Operation%" -eq "Renew") {
        throw "Renew was requested but no existing NSX-ALB certificate object was found."
    }
}
