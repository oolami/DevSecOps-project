    "%NSX-ALB-Host%/login" `
    -SessionVariable session `
    -Method POST `
    -Headers $headers `
    -Body $signInBody `
    -UseBasicParsing










$nsxAlbUri = [System.Uri]"%NSX-ALB-Host%"

$csrfCookie = $session.Cookies.GetCookies($nsxAlbUri)['csrftoken']

if (-not $csrfCookie) {
    throw "NSX-ALB login succeeded, but csrftoken cookie was not found."
}

$Headers['X-CSRFToken'] = $csrfCookie.Value
$Headers['Referer'] = "%NSX-ALB-Host%/"






