 const sendMsTeamsMessage = async (userName: string, reservedAtTs: number, envName: string) => {
  const message = `
⚠️ CICD Environment Reservation Expiration Reminder

Environment: ${envName}
Reserved By: ${userName}

This environment reservation will expire in approximately 1 day.

If you still need this environment, please re-reserve it or extend the reservation before it expires.

If it is no longer needed, no action is required.
`

  if (!config.msTeamsWebhookUrl) {
    logger.warn("Can't send message to %s about %s env reservation", userName, envName)
    return
  }

  const res = await fetch(config.msTeamsWebhookUrl, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      type: "message",
      attachments: [
        {
          contentType: "application/vnd.microsoft.card.adaptive",
          content: {
            type: "AdaptiveCard",
            version: "1.4",
            body: [
              {
                type: "TextBlock",
                text: message,
                wrap: true,
              },
            ],
          },
        },
      ],
    }),
  })

  if (!res.ok) {
    logger.warn("Response status code is %d", res.status)
  }
}







const getEnvReservationTtl = async (envName: string): Promise<number> => {
  try {
    return await client.ttl(`${envReservationPrefix}${envName}`)
  } catch (e) {
    logger.error("failed to get ttl for env reservation %s %o", envName, e)
    return -1
  }
}
