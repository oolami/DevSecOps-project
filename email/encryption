$DryRunRaw = "%DryRun%"
$DryRun = $DryRunRaw.Trim().ToLower() -eq "true"

$ErrorActionPreference = 'Stop'

if ($DryRun) {
    Write-Host "======================================"
    Write-Host "DRY RUN - ISSUE CERTIFICATE"
    Write-Host "======================================"
    Write-Host "Certificate issuance would be performed."
    Write-Host "No certificate request will be submitted."
    exit 0
}

certreq -Submit `
    -config "SILAC-SubCA.silacins.com\SILAC-SubCA" `
    -attrib "CertificateTemplate:CertificateTemplateName" `
    "%teamcity.build.id%.csr" `
    "%teamcity.build.id%.crt"

Write-Host "Certificate Issued and saved into %teamcity.build.id%.crt file"