@dataclass
class ReportEvent:
    ts: float
    level: str  # INFO/WARN/ERROR
    action: str
    details: Dict[str, Any]


class Reporter:
    def __init__(self) -> None:
        self.events: List[ReportEvent] = []
        self.counts = {"INFO": 0, "WARN": 0, "ERROR": 0}

    def log(self, level: str, action: str, **details: Any) -> None:
        level_u = level.upper()
        if level_u not in self.counts:
            level_u = "INFO"
        self.counts[level_u] += 1
        self.events.append(ReportEvent(ts=time.time(), level=level_u, action=action, details=details))

    def info(self, action: str, **details: Any) -> None:
        self.log("INFO", action, **details)

    def warn(self, action: str, **details: Any) -> None:
        self.log("WARN", action, **details)

    def error(self, action: str, **details: Any) -> None:
        self.log("ERROR", action, **details)

    def to_dict(self) -> Dict[str, Any]:
        return {
            "summary": {
                "counts": self.counts,
                "total_events": len(self.events),
            },
            "events": [
                {"ts": e.ts, "level": e.level, "action": e.action, "details": e.details}
                for e in self.events
            ],
        }

    def write(self, path: str) -> None:
        os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(self.to_dict(), f, indent=2)


# =========================
# Helpers: JSON load + filters
