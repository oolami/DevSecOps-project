@dataclass
class SgInfo:
    sg_id: str
    name: str
    description: str
    vpc_id: str
    tags: Dict[str, str]
    ip_permissions: List[Dict[str, Any]]
    ip_permissions_egress: List[Dict[str, Any]]


def describe_all_sgs(ec2_client, vpc_id: str) -> List[Dict[str, Any]]:
    paginator = ec2_client.get_paginator("describe_security_groups")
    out: List[Dict[str, Any]] = []
    for page in paginator.paginate(Filters=[{"Name": "vpc-id", "Values": [vpc_id]}]):
        out.extend(page.get("SecurityGroups", []))
    return out


def sg_to_info(sg: Dict[str, Any]) -> SgInfo:
    tags = {t["Key"]: t.get("Value", "") for t in sg.get("Tags", []) if "Key" in t}
    return SgInfo(
        sg_id=sg["GroupId"],
        name=sg.get("GroupName", ""),
        description=sg.get("Description", ""),
        vpc_id=sg.get("VpcId", ""),
        tags=tags,
        ip_permissions=sg.get("IpPermissions", []) or [],
        ip_permissions_egress=sg.get("IpPermissionsEgress", []) or [],
    )


def build_dr_sg_indexes(dr_sgs: List[SgInfo]) -> Tuple[Dict[str, SgInfo], Dict[str, List[SgInfo]]]:
    """
    Returns:
      - by_name: exact name -> SG
      - by_base: base name -> [SGs...]
    """
    by_name: Dict[str, SgInfo] = {}
    by_base: Dict[str, List[SgInfo]] = {}
    for s in dr_sgs:
        by_name[s.name] = s
        b = base_name(s.name)
        by_base.setdefault(b, []).append(s)
    return by_name, by_base


def ensure_sg_exists_in_dr(
    *,
    prod_sg: SgInfo,
    dr_ec2,
    dr_vpc_id: str,
    dr_by_name: Dict[str, SgInfo],
    dr_by_base: Dict[str, List[SgInfo]],
    prod_to_dr_sg_id: Dict[str, str],
    dry_run: bool,
    reporter: Reporter,
) -> None:
    """
    Choose an existing DR SG if it matches by exact name OR base-name (stack suffix mismatch),
    else create a new DR SG.
    """
    # If already mapped, nothing to do
    if prod_sg.sg_id in prod_to_dr_sg_id:
        return

    # 1) exact name match
    if prod_sg.name in dr_by_name:
        prod_to_dr_sg_id[prod_sg.sg_id] = dr_by_name[prod_sg.name].sg_id
        reporter.info("SG_MAP_EXISTING_EXACT", prod_sg=prod_sg.name, dr_sg=dr_by_name[prod_sg.name].name)
        return

    # 2) base-name match (your “suffix differs between prod and DR” case)
    prod_base = base_name(prod_sg.name)
    candidates = dr_by_base.get(prod_base, [])
    if candidates:
        # If multiple, pick the oldest-ish deterministic choice: lowest GroupId lexicographically (stable)
        chosen = sorted(candidates, key=lambda x: x.sg_id)[0]
        prod_to_dr_sg_id[prod_sg.sg_id] = chosen.sg_id
        reporter.warn(
            "SG_MAP_EXISTING_BASE",
            prod_sg=prod_sg.name,
            dr_sg=chosen.name,
            note="Mapped by base-name to avoid duplicates (suffix differs).",
        )
        return

    # 3) create new with deterministic suffix if stack-suffix present
    dr_name = dr_name_for_prod_sg(prod_sg.name, prod_sg.sg_id, dr_vpc_id)

    # if that deterministic name exists (race / prior run), adopt it
    if dr_name in dr_by_name:
        prod_to_dr_sg_id[prod_sg.sg_id] = dr_by_name[dr_name].sg_id
        reporter.info("SG_MAP_EXISTING_DETERMINISTIC", prod_sg=prod_sg.name, dr_sg=dr_name)
        return

    reporter.info("SG_CREATE", prod_sg=prod_sg.name, dr_sg=dr_name, dry_run=dry_run)
    if dry_run:
        # fake map to a placeholder; later rule sync should skip create calls anyway in dry-run
        prod_to_dr_sg_id[prod_sg.sg_id] = f"dryrun:{dr_name}"
        return

    try:
        resp = dr_ec2.create_security_group(
            GroupName=dr_name,
            Description=prod_sg.description or dr_name,
            VpcId=dr_vpc_id,
        )
        new_id = resp["GroupId"]
        # Refresh indexes
        new_info = SgInfo(
            sg_id=new_id,
            name=dr_name,
            description=prod_sg.description or dr_name,
            vpc_id=dr_vpc_id,
            tags={},  # we are not copying tags
            ip_permissions=[],
            ip_permissions_egress=[],
        )
        dr_by_name[dr_name] = new_info
        dr_by_base.setdefault(base_name(dr_name), []).append(new_info)
        prod_to_dr_sg_id[prod_sg.sg_id] = new_id
    except ClientError as e:
        reporter.error("SG_CREATE_FAILED", prod_sg=prod_sg.name, dr_sg=dr_name, error=str(e))
        raise


def normalize_ip_permission_for_compare(perm: Dict[str, Any], prod_to_dr_sg_id: Dict[str, str]) -> Dict[str, Any]:
    """
    Normalize IpPermission for set-comparison:
    - Sort IpRanges, Ipv6Ranges, PrefixListIds, UserIdGroupPairs
    - Map referenced SG IDs from PROD->DR where possible
    """
    p = copy.deepcopy(perm)

    def sort_key(d: Dict[str, Any], keys: List[str]) -> Tuple:
        return tuple(d.get(k) for k in keys)

    # UserIdGroupPairs: map GroupId if present
    ugps = []
    for u in p.get("UserIdGroupPairs", []) or []:
        u2 = dict(u)
        gid = u2.get("GroupId")
        if gid and gid in prod_to_dr_sg_id and not str(prod_to_dr_sg_id[gid]).startswith("dryrun:"):
            u2["GroupId"] = prod_to_dr_sg_id[gid]
        # Drop fields that can differ but are not required for authorization comparison
        # (e.g., UserId may be different across accounts)
        u2.pop("UserId", None)
        u2.pop("GroupName", None)
        ugps.append(u2)
    ugps = sorted(ugps, key=lambda x: sort_key(x, ["GroupId", "VpcId", "VpcPeeringConnectionId", "PeeringStatus"]))
    p["UserIdGroupPairs"] = ugps

    # IP ranges
    iprs = sorted((p.get("IpRanges", []) or []), key=lambda x: x.get("CidrIp", ""))
    p["IpRanges"] = iprs
    ipv6 = sorted((p.get("Ipv6Ranges", []) or []), key=lambda x: x.get("CidrIpv6", ""))
    p["Ipv6Ranges"] = ipv6
    pls = sorted((p.get("PrefixListIds", []) or []), key=lambda x: x.get("PrefixListId", ""))
    p["PrefixListIds"] = pls

    # Only keep stable keys
    stable = {
        "FromPort": p.get("FromPort"),
        "ToPort": p.get("ToPort"),
        "IpProtocol": p.get("IpProtocol"),
        "IpRanges": p.get("IpRanges", []),
        "Ipv6Ranges": p.get("Ipv6Ranges", []),
        "PrefixListIds": p.get("PrefixListIds", []),
        "UserIdGroupPairs": p.get("UserIdGroupPairs", []),
    }
    return stable


def perm_list_to_set(perms: List[Dict[str, Any]], prod_to_dr_sg_id: Dict[str, str]) -> Set[str]:
    """
    Convert perms list into a comparable set by json-dumping normalized perms.
    """
    s: Set[str] = set()
    for p in perms or []:
        norm = normalize_ip_permission_for_compare(p, prod_to_dr_sg_id)
        s.add(json.dumps(norm, sort_keys=True))
    return s


def ensure_sg_rules_synced(
    *,
    prod_sg: SgInfo,
    dr_sg: SgInfo,
    dr_ec2,
    prod_to_dr_sg_id: Dict[str, str],
    dry_run: bool,
    reporter: Reporter,
) -> None:
    """
    Add missing inbound/outbound rules in DR to match PROD.
    Never removes rules from DR (safe).
    """
    if dr_sg.sg_id.startswith("dryrun:"):
        reporter.info("SG_RULES_SKIP_DRYRUN_PLACEHOLDER", sg=dr_sg.name)
        return

    prod_in_set = perm_list_to_set(prod_sg.ip_permissions, prod_to_dr_sg_id)
    dr_in_set = perm_list_to_set(dr_sg.ip_permissions, prod_to_dr_sg_id)
    missing_in = prod_in_set - dr_in_set

    prod_out_set = perm_list_to_set(prod_sg.ip_permissions_egress, prod_to_dr_sg_id)
    dr_out_set = perm_list_to_set(dr_sg.ip_permissions_egress, prod_to_dr_sg_id)
    missing_out = prod_out_set - dr_out_set

    # Convert missing back to IpPermission dicts
    missing_in_perms = [json.loads(x) for x in sorted(missing_in)]
    missing_out_perms = [json.loads(x) for x in sorted(missing_out)]

    if missing_in_perms:
        reporter.info("SG_AUTHORIZE_INGRESS", sg=dr_sg.name, count=len(missing_in_perms), dry_run=dry_run)
        if not dry_run:
            try:
                dr_ec2.authorize_security_group_ingress(GroupId=dr_sg.sg_id, IpPermissions=missing_in_perms)
            except ClientError as e:
                # Often duplicates can still happen due to AWS normalization; treat InvalidPermission.Duplicate as warn
                code = e.response.get("Error", {}).get("Code", "")
                if code in ("InvalidPermission.Duplicate",):
                    reporter.warn("SG_INGRESS_DUPLICATE_IGNORED", sg=dr_sg.name, error=str(e))
                else:
                    reporter.error("SG_INGRESS_ADD_FAILED", sg=dr_sg.name, error=str(e))
                    raise

    if missing_out_perms:
        reporter.info("SG_AUTHORIZE_EGRESS", sg=dr_sg.name, count=len(missing_out_perms), dry_run=dry_run)
        if not dry_run:
            try:
                dr_ec2.authorize_security_group_egress(GroupId=dr_sg.sg_id, IpPermissions=missing_out_perms)
            except ClientError as e:
                code = e.response.get("Error", {}).get("Code", "")
                if code in ("InvalidPermission.Duplicate",):
                    reporter.warn("SG_EGRESS_DUPLICATE_IGNORED", sg=dr_sg.name, error=str(e))
                else:
                    reporter.error("SG_EGRESS_ADD_FAILED", sg=dr_sg.name, error=str(e))
                    raise


