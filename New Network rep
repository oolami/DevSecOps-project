@dataclass
class TgInfo:
    arn: str
    name: str
    proto: str
    port: int
    vpc_id: str
    target_type: str
    health_check: Dict[str, Any]
    attrs: Dict[str, str]


def list_target_groups(elbv2_client) -> List[Dict[str, Any]]:
    paginator = elbv2_client.get_paginator("describe_target_groups")
    out: List[Dict[str, Any]] = []
    for page in paginator.paginate():
        out.extend(page.get("TargetGroups", []))
    return out


def get_tg_attributes(elbv2_client, tg_arn: str) -> Dict[str, str]:
    resp = elbv2_client.describe_target_group_attributes(TargetGroupArn=tg_arn)
    attrs = {a["Key"]: a["Value"] for a in resp.get("Attributes", [])}
    return attrs


def tg_to_info(elbv2_client, tg: Dict[str, Any]) -> TgInfo:
    return TgInfo(
        arn=tg["TargetGroupArn"],
        name=tg["TargetGroupName"],
        proto=tg["Protocol"],
        port=int(tg.get("Port", 0) or 0),
        vpc_id=tg.get("VpcId", ""),
        target_type=tg.get("TargetType", "instance"),
        health_check={
            "HealthCheckProtocol": tg.get("HealthCheckProtocol"),
            "HealthCheckPort": tg.get("HealthCheckPort"),
            "HealthCheckEnabled": tg.get("HealthCheckEnabled"),
            "HealthCheckPath": tg.get("HealthCheckPath"),
            "HealthCheckIntervalSeconds": tg.get("HealthCheckIntervalSeconds"),
            "HealthCheckTimeoutSeconds": tg.get("HealthCheckTimeoutSeconds"),
            "HealthyThresholdCount": tg.get("HealthyThresholdCount"),
            "UnhealthyThresholdCount": tg.get("UnhealthyThresholdCount"),
            "Matcher": tg.get("Matcher"),
        },
        attrs=get_tg_attributes(elbv2_client, tg["TargetGroupArn"]),
    )


def ensure_tg_in_dr(
    *,
    prod_tg: TgInfo,
    dr_elbv2,
    dr_vpc_id: str,
    dr_tgs_by_name: Dict[str, TgInfo],
    prod_to_dr_tg_arn: Dict[str, str],
    dry_run: bool,
    reporter: Reporter,
) -> None:
    if prod_tg.arn in prod_to_dr_tg_arn:
        return

    if prod_tg.name in dr_tgs_by_name:
        prod_to_dr_tg_arn[prod_tg.arn] = dr_tgs_by_name[prod_tg.name].arn
        reporter.info("TG_EXISTS", tg=prod_tg.name)
        return

    reporter.info("TG_CREATE", tg=prod_tg.name, dry_run=dry_run)
    if dry_run:
        prod_to_dr_tg_arn[prod_tg.arn] = f"dryrun:{prod_tg.name}"
        return

    try:
        resp = dr_elbv2.create_target_group(
            Name=prod_tg.name,
            Protocol=prod_tg.proto,
            Port=prod_tg.port,
            VpcId=dr_vpc_id,
            TargetType=prod_tg.target_type,
            **{k: v for k, v in prod_tg.health_check.items() if v is not None},
        )
        new_tg = resp["TargetGroups"][0]
        new_info = TgInfo(
            arn=new_tg["TargetGroupArn"],
            name=new_tg["TargetGroupName"],
            proto=new_tg["Protocol"],
            port=int(new_tg.get("Port", 0) or 0),
            vpc_id=new_tg.get("VpcId", ""),
            target_type=new_tg.get("TargetType", "instance"),
            health_check=prod_tg.health_check,
            attrs=prod_tg.attrs,
        )
        # set attributes (best-effort)
        try:
            dr_elbv2.modify_target_group_attributes(
                TargetGroupArn=new_info.arn,
                Attributes=[{"Key": k, "Value": v} for k, v in (prod_tg.attrs or {}).items()],
            )
        except ClientError as e:
            reporter.warn("TG_ATTRS_SET_FAILED", tg=prod_tg.name, error=str(e))

        dr_tgs_by_name[new_info.name] = new_info
        prod_to_dr_tg_arn[prod_tg.arn] = new_info.arn
    except ClientError as e:
        reporter.error("TG_CREATE_FAILED", tg=prod_tg.name, error=str(e))
        raise


