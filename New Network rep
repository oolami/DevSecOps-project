def load_config(path: str) -> Dict[str, Any]:
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except json.JSONDecodeError as e:
        # Friendly message (your screenshots showed errors like "Extra data" / "Expecting ',' delimiter")
        msg = f"Invalid JSON in config file '{path}': {e.msg} at line {e.lineno} col {e.colno} (char {e.pos})"
        raise RuntimeError(msg) from e
    except FileNotFoundError as e:
        raise RuntimeError(f"Config file not found: {path}") from e


def prefixes_match(name: str, prefixes: List[str]) -> bool:
    if not prefixes:
        return True
    return any(name.startswith(p) for p in prefixes)


# =========================
# Stack suffix handling (SG names)
# =========================

# Treat endings like "-wf6YhVwT12IE" or "-1T2IYI2WLMCN" as stack/random suffixes.
STACK_SUFFIX_RE = re.compile(r"^(.*)-([A-Za-z0-9]{8,})$")


def split_stack_suffix(name: str) -> Tuple[str, Optional[str]]:
    """
    If name ends with -<8+ alnum>, returns (base, suffix); else (name, None)
    """
    m = STACK_SUFFIX_RE.match(name or "")
    if not m:
        return name, None
    return m.group(1), m.group(2)


def dr_name_for_prod_sg(prod_name: str, prod_sg_id: str, dr_vpc_id: str) -> str:
    """
    If PROD name ends with a stack suffix, generate a deterministic DR suffix (no '-dr-').
    Otherwise return the same name.
    """
    base, suffix = split_stack_suffix(prod_name)
    if suffix is None:
        return prod_name

    seed = f"{prod_sg_id}:{dr_vpc_id}:{base}".encode("utf-8")
    # 10 chars keeps it “suffix-like” without looking like "-dr-"
    dr_suffix = hashlib.sha256(seed).hexdigest()[:10]
    return f"{base}-{dr_suffix}"


def base_name(name: str) -> str:
    b, s = split_stack_suffix(name)
    return b


