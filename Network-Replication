#!/usr/bin/env python3
"""
replicate_networking.py

Replicate (Prod -> DR) networking resources across accounts/regions:
- Security Groups (create missing, update rules; two-pass for SG->SG references)
- Target Groups
- Load Balancers + Listeners

Constraints:
- Prod MUST be read-only: script only calls Describe/List APIs in prod session.
- DR can create/modify resources.

Usage:
  python replicate_networking.py --config config.json --dry-run --report report.json
  python replicate_networking.py --config config.json --report report.json
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from dataclasses import dataclass
from typing import Any, Dict, List, Optional, Tuple

import boto3
from botocore.exceptions import ClientError


# -----------------------------
# Helpers: suffix + matching
# -----------------------------

# Treat suffixes like "wf6YhVwT12IE" or "1T2IYVI2LWLCN" as random/stack suffix
STACK_SUFFIX_RE = re.compile(r"^[A-Za-z0-9]{8,}$")  # conservative threshold


def split_stack_suffix(name: str) -> Tuple[str, Optional[str]]:
    """
    If name looks like 'base-<randomSuffix>', return (base, suffix).
    Else return (name, None).
    """
    if not name or "-" not in name:
        return name, None
    base, suffix = name.rsplit("-", 1)
    if STACK_SUFFIX_RE.match(suffix):
        return base, suffix
    return name, None


def deterministic_suffix(seed: str, length: int = 12) -> str:
    """
    Deterministic suffix for DR. No '-dr-' added. Only alnum, stable.
    """
    h = hashlib.sha1(seed.encode("utf-8")).hexdigest()  # stable
    # take hex and trim
    return h[:length]


def is_aws_reserved_tag_key(k: str) -> bool:
    return k.lower().startswith("aws:")


def safe_copy_tags(tags: List[Dict[str, str]], copy_all_tags: bool) -> List[Dict[str, str]]:
    """
    - If copy_all_tags is False: return []
    - Else copy tags except aws:* (reserved)
    """
    if not copy_all_tags:
        return []
    out = []
    for t in tags or []:
        key = t.get("Key", "")
        if not key:
            continue
        if is_aws_reserved_tag_key(key):
            continue
        out.append({"Key": key, "Value": t.get("Value", "")})
    return out


def best_candidate_sg(candidates: List[Dict[str, Any]]) -> Optional[Dict[str, Any]]:
    """
    If multiple matches, pick deterministically.
    Currently picks the highest GroupId lexicographically (stable).
    """
    if not candidates:
        return None
    return sorted(candidates, key=lambda x: x.get("GroupId", ""))[-1]


def list_sgs_in_vpc(ec2_client, vpc_id: str) -> List[Dict[str, Any]]:
    paginator = ec2_client.get_paginator("describe_security_groups")
    sgs: List[Dict[str, Any]] = []
    for page in paginator.paginate(Filters=[{"Name": "vpc-id", "Values": [vpc_id]}]):
        sgs.extend(page.get("SecurityGroups", []))
    return sgs


def find_existing_dr_sg_for_prod_name(
    dr_ec2,
    dr_vpc_id: str,
    prod_sg_name: str
) -> Optional[Dict[str, Any]]:
    """
    If Prod SG has a stack-like suffix, find any DR SG that matches the same base name
    with ANY suffix (including different one). If Prod SG is NOT suffix-like, match exact.
    """
    base, suffix = split_stack_suffix(prod_sg_name)
    dr_sgs = list_sgs_in_vpc(dr_ec2, dr_vpc_id)

    if suffix is None:
        # exact match
        matches = [sg for sg in dr_sgs if sg.get("GroupName") == prod_sg_name]
        return best_candidate_sg(matches)

    prefix = base + "-"
    matches = [sg for sg in dr_sgs if sg.get("GroupName", "").startswith(prefix)]

    # Prefer NOT matching the prod exact suffix to avoid duplicates
    non_prod = [sg for sg in matches if sg.get("GroupName") != prod_sg_name]
    if non_prod:
        return best_candidate_sg(non_prod)

    return best_candidate_sg(matches)


# -----------------------------
# Config + report structures
# -----------------------------

@dataclass
class FiltersCfg:
    security_group_name_prefixes: List[str]
    load_balancer_name_prefixes: List[str]
    target_group_name_prefixes: List[str]


@dataclass
class VpcMapCfg:
    prod_vpc_id: str
    dr_vpc_id: str
    subnet_map: Dict[str, str]  # prod_subnet_id -> dr_subnet_id


@dataclass
class Config:
    prod_profile: str
    dr_profile: str
    prod_region: str
    dr_region: str
    vpc_map: VpcMapCfg
    filters: FiltersCfg
    cert_map: Dict[str, str]       # prod_cert_arn -> dr_cert_arn (optional)
    copy_tags: bool                # if False, copy no tags at all


def load_config(path: str) -> Config:
    with open(path, "r", encoding="utf-8") as f:
        cfg = json.load(f)

    filters = cfg.get("filters", {})
    vpc_map = cfg["vpc_map"]

    return Config(
        prod_profile=cfg["prod_profile"],
        dr_profile=cfg["dr_profile"],
        prod_region=cfg["prod_region"],
        dr_region=cfg["dr_region"],
        vpc_map=VpcMapCfg(
            prod_vpc_id=vpc_map["prod_vpc_id"],
            dr_vpc_id=vpc_map["dr_vpc_id"],
            subnet_map=vpc_map.get("subnet_map", {}),
        ),
        filters=FiltersCfg(
            security_group_name_prefixes=filters.get("security_group_name_prefixes", []),
            load_balancer_name_prefixes=filters.get("load_balancer_name_prefixes", []),
            target_group_name_prefixes=filters.get("target_group_name_prefixes", []),
        ),
        cert_map=cfg.get("cert_map", {}),
        copy_tags=bool(cfg.get("copy_tags", True)),
    )


def name_matches_prefixes(name: str, prefixes: List[str]) -> bool:
    if not prefixes:
        return True
    return any(name.startswith(p) for p in prefixes)


def report_init() -> Dict[str, Any]:
    return {
        "summary": {},
        "security_groups": [],
        "target_groups": [],
        "load_balancers": [],
        "warnings": [],
        "errors": [],
    }


def rep_log(report: Dict[str, Any], kind: str, msg: str, data: Optional[Dict[str, Any]] = None):
    entry = {"message": msg}
    if data:
        entry.update(data)
    report.setdefault(kind, []).append(entry)


