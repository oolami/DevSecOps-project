def get_sessions(cfg: Config):
    prod_sess = boto3.Session(profile_name=cfg.prod_profile, region_name=cfg.prod_region)
    dr_sess = boto3.Session(profile_name=cfg.dr_profile, region_name=cfg.dr_region)
    return prod_sess, dr_sess


def prod_ec2(prod_sess): return prod_sess.client("ec2")
def dr_ec2(dr_sess): return dr_sess.client("ec2")
def prod_elbv2(prod_sess): return prod_sess.client("elbv2")
def dr_elbv2(dr_sess): return dr_sess.client("elbv2")


# -----------------------------
# Security Groups replication
# -----------------------------

def list_prod_security_groups(prod_ec2c, prod_vpc_id: str, prefixes: List[str]) -> List[Dict[str, Any]]:
    # Prod read-only: describe_security_groups is safe
    all_sgs = list_sgs_in_vpc(prod_ec2c, prod_vpc_id)
    out = []
    for sg in all_sgs:
        name = sg.get("GroupName", "")
        if name_matches_prefixes(name, prefixes):
            out.append(sg)
    return out


def ensure_sg_in_dr(
    dr_ec2c,
    dr_vpc_id: str,
    prod_sg: Dict[str, Any],
    dry_run: bool,
    report: Dict[str, Any],
    cfg: Config,
) -> Optional[str]:
    """
    Create missing SG (only if no matching DR SG already exists).
    For stack suffix SGs, reuse existing DR SG with same base-* if present.
    """
    prod_name = prod_sg["GroupName"]
    prod_id = prod_sg["GroupId"]

    existing = find_existing_dr_sg_for_prod_name(dr_ec2c, dr_vpc_id, prod_name)
    if existing:
        rep_log(report, "security_groups", "Reuse existing DR SG (skip create)",
                {"action": "reuse", "prod_name": prod_name, "prod_id": prod_id,
                 "dr_name": existing.get("GroupName"), "dr_id": existing.get("GroupId")})
        return existing["GroupId"]

    # Not found -> create one DR SG
    base, suffix = split_stack_suffix(prod_name)
    if suffix is not None:
        # deterministic DR suffix seeded by prod GroupId (stable) + base
        dr_sfx = deterministic_suffix(seed=f"{base}:{prod_id}:{cfg.vpc_map.dr_vpc_id}", length=12)
        dr_name = f"{base}-{dr_sfx}"
    else:
        dr_name = prod_name

    tags = safe_copy_tags(prod_sg.get("Tags", []), cfg.copy_tags)

    rep_log(report, "security_groups", "Create DR SG",
            {"action": "create", "prod_name": prod_name, "prod_id": prod_id,
             "dr_name": dr_name, "dry_run": dry_run})

    if dry_run:
        return None

    try:
        resp = dr_ec2c.create_security_group(
            GroupName=dr_name,
            Description=prod_sg.get("Description", dr_name),
            VpcId=dr_vpc_id,
            TagSpecifications=[{"ResourceType": "security-group", "Tags": tags}] if tags else []
        )
        return resp["GroupId"]
    except ClientError as e:
        rep_log(report, "errors", "Failed to create DR SG",
                {"prod_name": prod_name, "error": str(e)})
        raise


def normalize_ip_permission_for_apply(
    perm: Dict[str, Any],
    prod_to_dr_sg_id: Dict[str, str],
) -> Dict[str, Any]:
    """
    Convert a Prod IpPermission into a DR-applicable IpPermission:
    - Replace any UserIdGroupPairs GroupId via prod_to_dr_sg_id map
    - Keep CIDR/IP ranges intact
    """
    out: Dict[str, Any] = {
        "IpProtocol": perm.get("IpProtocol"),
    }
    if "FromPort" in perm:
        out["FromPort"] = perm.get("FromPort")
    if "ToPort" in perm:
        out["ToPort"] = perm.get("ToPort")

    # CIDRs
    if perm.get("IpRanges"):
        out["IpRanges"] = [{"CidrIp": r.get("CidrIp"), "Description": r.get("Description")}
                           for r in perm.get("IpRanges", []) if r.get("CidrIp")]
    if perm.get("Ipv6Ranges"):
        out["Ipv6Ranges"] = [{"CidrIpv6": r.get("CidrIpv6"), "Description": r.get("Description")}
                             for r in perm.get("Ipv6Ranges", []) if r.get("CidrIpv6")]
    if perm.get("PrefixListIds"):
        out["PrefixListIds"] = [{"PrefixListId": r.get("PrefixListId"), "Description": r.get("Description")}
                                for r in perm.get("PrefixListIds", []) if r.get("PrefixListId")]

    # SG references
    ugps = []
    for ugp in perm.get("UserIdGroupPairs", []) or []:
        prod_gid = ugp.get("GroupId")
        if not prod_gid:
            continue
        dr_gid = prod_to_dr_sg_id.get(prod_gid)
        if not dr_gid:
            # if we can't map it, skip this referenced rule (but report elsewhere)
            continue
        ugps.append({"GroupId": dr_gid, "Description": ugp.get("Description")})
    if ugps:
        out["UserIdGroupPairs"] = ugps

    return out


def ipperm_key(perm: Dict[str, Any]) -> str:
    """
    Stable key for permission diffing.
    """
    proto = perm.get("IpProtocol")
    fp = perm.get("FromPort", "")
    tp = perm.get("ToPort", "")
    parts = [str(proto), str(fp), str(tp)]

    def add_ranges(label: str, items: List[Dict[str, Any]], field: str):
        vals = sorted([i.get(field, "") for i in items if i.get(field)])
        parts.append(label + ":" + ",".join(vals))

    add_ranges("v4", perm.get("IpRanges", []) or [], "CidrIp")
    add_ranges("v6", perm.get("Ipv6Ranges", []) or [], "CidrIpv6")
    add_ranges("pl", perm.get("PrefixListIds", []) or [], "PrefixListId")

    ugps = sorted([u.get("GroupId", "") for u in perm.get("UserIdGroupPairs", []) or [] if u.get("GroupId")])
    parts.append("sg:" + ",".join(ugps))
    return "|".join(parts)


def diff_permissions(prod_perms: List[Dict[str, Any]], dr_perms: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """
    Return a list of permissions present in prod but missing in dr.
    """
    dr_keys = {ipperm_key(p): p for p in dr_perms or []}
    missing = []
    for p in prod_perms or []:
        if ipperm_key(p) not in dr_keys:
            missing.append(p)
    return missing


def sync_sg_rules_two_pass(
    prod_ec2c,
    dr_ec2c,
    prod_sgs: List[Dict[str, Any]],
    prod_to_dr_sg_id: Dict[str, str],
    dry_run: bool,
    report: Dict[str, Any],
):
    """
    Two-pass SG rule sync:
      Pass 1: sync rules that do NOT reference SGs (CIDR/prefixlist) and SG refs that already map
      Pass 2: re-run now that SG mappings exist, apply SG->SG referenced rules.
    """
    # Build DR SG objects cache
    dr_sg_ids = list(set(prod_to_dr_sg_id.values()))
    dr_sgs_by_id: Dict[str, Dict[str, Any]] = {}
    if dr_sg_ids:
        # DR read describe for those ids
        resp = dr_ec2c.describe_security_groups(GroupIds=dr_sg_ids)
        for sg in resp.get("SecurityGroups", []):
            dr_sgs_by_id[sg["GroupId"]] = sg

    def refresh_dr_sg(dr_sg_id: str) -> Dict[str, Any]:
        resp = dr_ec2c.describe_security_groups(GroupIds=[dr_sg_id])
        return resp["SecurityGroups"][0]

    def apply_missing(dr_sg_id: str, direction: str, missing_perms: List[Dict[str, Any]]):
        if not missing_perms:
            return
        rep_log(report, "security_groups", f"Add missing {direction} rules",
                {"action": "authorize", "dr_sg_id": dr_sg_id, "count": len(missing_perms), "dry_run": dry_run})
        if dry_run:
            return
        if direction == "ingress":
            dr_ec2c.authorize_security_group_ingress(GroupId=dr_sg_id, IpPermissions=missing_perms)
        else:
            dr_ec2c.authorize_security_group_egress(GroupId=dr_sg_id, IpPermissions=missing_perms)

    def do_pass(pass_num: int):
        for prod_sg in prod_sgs:
            prod_id = prod_sg["GroupId"]
            dr_id = prod_to_dr_sg_id.get(prod_id)
            if not dr_id:
                continue

            # Always fetch fresh DR SG if not cached
            dr_sg = dr_sgs_by_id.get(dr_id) or refresh_dr_sg(dr_id)
            dr_sgs_by_id[dr_id] = dr_sg

            # Prepare prod permissions in DR-applicable form
            prod_ing = [normalize_ip_permission_for_apply(p, prod_to_dr_sg_id) for p in (prod_sg.get("IpPermissions") or [])]
            prod_egr = [normalize_ip_permission_for_apply(p, prod_to_dr_sg_id) for p in (prod_sg.get("IpPermissionsEgress") or [])]

            # Pass gating: in pass 1, drop any perm that STILL contains SG pairs that were unmapped and got removed
            # We also skip "empty" perms (e.g., SG-ref only but was removed).
            def valid_perm(p: Dict[str, Any]) -> bool:
                has_any = bool(p.get("IpRanges") or p.get("Ipv6Ranges") or p.get("PrefixListIds") or p.get("UserIdGroupPairs"))
                return has_any

            prod_ing = [p for p in prod_ing if valid_perm(p)]
            prod_egr = [p for p in prod_egr if valid_perm(p)]

            dr_ing = dr_sg.get("IpPermissions") or []
            dr_egr = dr_sg.get("IpPermissionsEgress") or []

            missing_ing = diff_permissions(prod_ing, dr_ing)
            missing_egr = diff_permissions(prod_egr, dr_egr)

            apply_missing(dr_id, "ingress", missing_ing)
            apply_missing(dr_id, "egress", missing_egr)

            rep_log(report, "security_groups", f"Pass {pass_num} SG sync complete",
                    {"action": "sync", "pass": pass_num, "prod_sg_id": prod_id, "dr_sg_id": dr_id,
                     "missing_ingress": len(missing_ing), "missing_egress": len(missing_egr)})

    do_pass(1)
    do_pass(2)


def build_prod_to_dr_sg_map(
    cfg: Config,
    prod_ec2c,
    dr_ec2c,
    prod_sgs: List[Dict[str, Any]],
    dry_run: bool,
    report: Dict[str, Any],
) -> Dict[str, str]:
    """
    Ensure SGs exist (or reused) in DR and return mapping prod_sg_id -> dr_sg_id.
    """
    mapping: Dict[str, str] = {}
    for psg in prod_sgs:
        dr_id = ensure_sg_in_dr(
            dr_ec2c=dr_ec2c,
            dr_vpc_id=cfg.vpc_map.dr_vpc_id,
            prod_sg=psg,
            dry_run=dry_run,
            report=report,
            cfg=cfg,
        )
        if dr_id:
            mapping[psg["GroupId"]] = dr_id
        else:
            # dry-run: we can't know created id; map is incomplete, but we can still report actions
            rep_log(report, "warnings", "Dry-run: DR SG IDs not available for mapping",
                    {"prod_sg_id": psg["GroupId"], "prod_name": psg.get("GroupName")})
    return mapping


