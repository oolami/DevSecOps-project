def list_all_target_groups(elb) -> List[Dict[str, Any]]:
    out = []
    paginator = elb.get_paginator("describe_target_groups")
    for page in paginator.paginate():
        out.extend(page.get("TargetGroups", []))
    return out


def list_prod_target_groups(prod_elb, prod_vpc_id: str, prefixes: List[str]) -> List[Dict[str, Any]]:
    tgs = list_all_target_groups(prod_elb)
    out = []
    for tg in tgs:
        if tg.get("VpcId") != prod_vpc_id:
            continue
        name = tg.get("TargetGroupName", "")
        if name_matches_prefixes(name, prefixes):
            out.append(tg)
    return out


def dr_find_tg_by_name(dr_elb, name: str) -> Optional[Dict[str, Any]]:
    try:
        resp = dr_elb.describe_target_groups(Names=[name])
        tgs = resp.get("TargetGroups", [])
        return tgs[0] if tgs else None
    except ClientError:
        return None


def ensure_tg_in_dr(
    cfg: Config,
    dr_elb,
    prod_tg: Dict[str, Any],
    dry_run: bool,
    report: Dict[str, Any],
) -> Optional[str]:
    name = prod_tg["TargetGroupName"]
    existing = dr_find_tg_by_name(dr_elb, name)
    if existing:
        rep_log(report, "target_groups", "Reuse existing DR Target Group",
                {"action": "reuse", "name": name, "dr_arn": existing.get("TargetGroupArn")})
        return existing.get("TargetGroupArn")

    # create TG in DR
    create_args = {
        "Name": name,
        "Protocol": prod_tg.get("Protocol"),
        "Port": prod_tg.get("Port"),
        "VpcId": cfg.vpc_map.dr_vpc_id,
        "TargetType": prod_tg.get("TargetType", "instance"),
    }

    # Health check settings (only set if present)
    for k in [
        "HealthCheckProtocol", "HealthCheckPort", "HealthCheckEnabled",
        "HealthCheckPath", "HealthCheckIntervalSeconds", "HealthCheckTimeoutSeconds",
        "HealthyThresholdCount", "UnhealthyThresholdCount", "Matcher"
    ]:
        if k in prod_tg and prod_tg[k] is not None:
            create_args[k] = prod_tg[k]

    rep_log(report, "target_groups", "Create DR Target Group",
            {"action": "create", "name": name, "dry_run": dry_run, "args": create_args})

    if dry_run:
        return None

    resp = dr_elb.create_target_group(**create_args)
    return resp["TargetGroups"][0]["TargetGroupArn"]


def build_prod_to_dr_tg_map(
    cfg: Config,
    prod_elb,
    dr_elb,
    prod_tgs: List[Dict[str, Any]],
    dry_run: bool,
    report: Dict[str, Any],
) -> Dict[str, str]:
    mapping: Dict[str, str] = {}
    for ptg in prod_tgs:
        dr_arn = ensure_tg_in_dr(cfg, dr_elb, ptg, dry_run, report)
        if dr_arn:
            mapping[ptg["TargetGroupArn"]] = dr_arn
        else:
            rep_log(report, "warnings", "Dry-run: DR TG ARNs not available for mapping",
                    {"prod_tg_arn": ptg["TargetGroupArn"], "name": ptg["TargetGroupName"]})
    return mapping


