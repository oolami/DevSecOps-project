def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--config", required=True, help="Path to config.json")
    ap.add_argument("--dry-run", action="store_true", help="Do not create/modify; only report actions.")
    ap.add_argument("--report", default="report.json", help="Write JSON report to this path.")
    args = ap.parse_args()

    cfg = load_config(args.config)
    report = report_init()

    # Sessions
    prod_sess, dr_sess = get_sessions(cfg)
    prod_ec2c = prod_ec2(prod_sess)
    dr_ec2c = dr_ec2(dr_sess)
    prod_elb = prod_elbv2(prod_sess)
    dr_elb = dr_elbv2(dr_sess)

    report["summary"] = {
        "prod_profile": cfg.prod_profile,
        "dr_profile": cfg.dr_profile,
        "prod_region": cfg.prod_region,
        "dr_region": cfg.dr_region,
        "prod_vpc_id": cfg.vpc_map.prod_vpc_id,
        "dr_vpc_id": cfg.vpc_map.dr_vpc_id,
        "dry_run": bool(args.dry_run),
        "copy_tags": cfg.copy_tags,
    }

    # 1) SGs
    rep_log(report, "warnings", "Prod is READ-ONLY enforced by design: only Describe/List APIs are used in prod.")
    prod_sgs = list_prod_security_groups(prod_ec2c, cfg.vpc_map.prod_vpc_id, cfg.filters.security_group_name_prefixes)
    rep_log(report, "security_groups", "Discovered prod security groups",
            {"action": "discover", "count": len(prod_sgs)})

    prod_to_dr_sg_id = build_prod_to_dr_sg_map(cfg, prod_ec2c, dr_ec2c, prod_sgs, args.dry_run, report)

    # Two-pass rules sync (only possible when not dry-run, because mapping is incomplete in dry-run)
    if args.dry_run:
        rep_log(report, "warnings", "Dry-run: SG rule sync is not fully evaluated because DR SG IDs are unknown until creation.")
    else:
        sync_sg_rules_two_pass(prod_ec2c, dr_ec2c, prod_sgs, prod_to_dr_sg_id, args.dry_run, report)

    # 2) Target Groups
    prod_tgs = list_prod_target_groups(prod_elb, cfg.vpc_map.prod_vpc_id, cfg.filters.target_group_name_prefixes)
    rep_log(report, "target_groups", "Discovered prod target groups",
            {"action": "discover", "count": len(prod_tgs)})

    prod_to_dr_tg_arn = build_prod_to_dr_tg_map(cfg, prod_elb, dr_elb, prod_tgs, args.dry_run, report)

    # 3) Load Balancers + listeners
    prod_lbs = list_prod_load_balancers(prod_elb, cfg.vpc_map.prod_vpc_id, cfg.filters.load_balancer_name_prefixes)
    rep_log(report, "load_balancers", "Discovered prod load balancers",
            {"action": "discover", "count": len(prod_lbs)})

    for plb in prod_lbs:
        plb_arn = plb["LoadBalancerArn"]
        name = plb["LoadBalancerName"]

        dr_lb_arn = ensure_lb_in_dr(cfg, prod_elb, dr_elb, plb, prod_to_dr_sg_id, args.dry_run, report)
        if not dr_lb_arn:
            rep_log(report, "load_balancers", "Skip LB (not created / missing mapping)",
                    {"action": "skip", "name": name})
            continue

        # listeners
        if args.dry_run:
            rep_log(report, "warnings", "Dry-run: listener creation is planned but not executed.",
                    {"lb_name": name})
        ensure_listeners_in_dr(cfg, prod_elb, dr_elb, plb_arn, dr_lb_arn, prod_to_dr_tg_arn, args.dry_run, report)

    # Write report
    with open(args.report, "w", encoding="utf-8") as f:
        json.dump(report, f, indent=2, default=str)

    print(f"Done. Report written to: {args.report}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("Interrupted.")
        sys.exit(130)
