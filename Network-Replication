def list_all_load_balancers(elb) -> List[Dict[str, Any]]:
    out = []
    paginator = elb.get_paginator("describe_load_balancers")
    for page in paginator.paginate():
        out.extend(page.get("LoadBalancers", []))
    return out


def list_prod_load_balancers(prod_elb, prod_vpc_id: str, prefixes: List[str]) -> List[Dict[str, Any]]:
    lbs = list_all_load_balancers(prod_elb)
    out = []
    for lb in lbs:
        if lb.get("VpcId") != prod_vpc_id:
            continue
        name = lb.get("LoadBalancerName", "")
        if name_matches_prefixes(name, prefixes):
            out.append(lb)
    return out


def dr_find_lb_by_name(dr_elb, name: str) -> Optional[Dict[str, Any]]:
    try:
        resp = dr_elb.describe_load_balancers(Names=[name])
        lbs = resp.get("LoadBalancers", [])
        return lbs[0] if lbs else None
    except ClientError:
        return None


def map_subnets(cfg: Config, prod_subnet_ids: List[str], report: Dict[str, Any]) -> Optional[List[str]]:
    dr_subnets = []
    for sid in prod_subnet_ids:
        dr_sid = cfg.vpc_map.subnet_map.get(sid)
        if not dr_sid:
            rep_log(report, "warnings", "No DR subnet mapping for prod subnet; cannot create LB using this subnet",
                    {"prod_subnet_id": sid})
            return None
        dr_subnets.append(dr_sid)
    return dr_subnets


def map_sg_ids(prod_sg_ids: List[str], prod_to_dr_sg_id: Dict[str, str], report: Dict[str, Any]) -> Optional[List[str]]:
    out = []
    for sgid in prod_sg_ids:
        drid = prod_to_dr_sg_id.get(sgid)
        if not drid:
            rep_log(report, "warnings", "No DR SG mapping for prod SG; LB may be skipped",
                    {"prod_sg_id": sgid})
            return None
        out.append(drid)
    return out


def ensure_lb_in_dr(
    cfg: Config,
    prod_elb,
    dr_elb,
    prod_lb: Dict[str, Any],
    prod_to_dr_sg_id: Dict[str, str],
    dry_run: bool,
    report: Dict[str, Any],
) -> Optional[str]:
    name = prod_lb["LoadBalancerName"]
    existing = dr_find_lb_by_name(dr_elb, name)
    if existing:
        rep_log(report, "load_balancers", "Reuse existing DR Load Balancer",
                {"action": "reuse", "name": name, "dr_arn": existing.get("LoadBalancerArn")})
        return existing.get("LoadBalancerArn")

    # Need subnet mapping
    prod_subnets = [az.get("SubnetId") for az in (prod_lb.get("AvailabilityZones") or []) if az.get("SubnetId")]
    dr_subnets = map_subnets(cfg, prod_subnets, report)
    if not dr_subnets:
        rep_log(report, "load_balancers", "Skip LB: missing subnet mapping",
                {"action": "skip", "name": name})
        return None

    create_args: Dict[str, Any] = {
        "Name": name,
        "Subnets": dr_subnets,
        "Scheme": prod_lb.get("Scheme"),
        "Type": prod_lb.get("Type"),
        "IpAddressType": prod_lb.get("IpAddressType", "ipv4"),
    }

    # SecurityGroups only for ALB/NLB? (NLB generally doesn't use SG unless TLS ALPN?; AWS: SGs apply to ALB and GWLB, not classic NLB)
    # In practice, if SGs present in prod_lb, map them; otherwise omit.
    prod_sgs = prod_lb.get("SecurityGroups") or []
    if prod_sgs:
        dr_sgs = map_sg_ids(prod_sgs, prod_to_dr_sg_id, report)
        if not dr_sgs:
            rep_log(report, "load_balancers", "Skip LB: missing SG mapping",
                    {"action": "skip", "name": name})
            return None
        create_args["SecurityGroups"] = dr_sgs

    rep_log(report, "load_balancers", "Create DR Load Balancer",
            {"action": "create", "name": name, "dry_run": dry_run, "args": create_args})

    if dry_run:
        return None

    resp = dr_elb.create_load_balancer(**create_args)
    return resp["LoadBalancers"][0]["LoadBalancerArn"]


def list_listeners(elb, lb_arn: str) -> List[Dict[str, Any]]:
    out = []
    paginator = elb.get_paginator("describe_listeners")
    for page in paginator.paginate(LoadBalancerArn=lb_arn):
        out.extend(page.get("Listeners", []))
    return out


def normalize_actions_for_dr(
    actions: List[Dict[str, Any]],
    prod_to_dr_tg_arn: Dict[str, str],
) -> Optional[List[Dict[str, Any]]]:
    """
    Convert Prod listener default actions to DR by mapping TargetGroupArn.
    If an action uses TargetGroupArn and mapping missing -> return None (cannot safely create).
    """
    out = []
    for a in actions or []:
        na = dict(a)
        if "TargetGroupArn" in na:
            prod_tg = na["TargetGroupArn"]
            dr_tg = prod_to_dr_tg_arn.get(prod_tg)
            if not dr_tg:
                return None
            na["TargetGroupArn"] = dr_tg
        # ForwardConfig may include multiple target groups
        if "ForwardConfig" in na and na["ForwardConfig"]:
            fc = dict(na["ForwardConfig"])
            tgs = []
            for tg in fc.get("TargetGroups", []) or []:
                prod_tg = tg.get("TargetGroupArn")
                if not prod_tg:
                    continue
                dr_tg = prod_to_dr_tg_arn.get(prod_tg)
                if not dr_tg:
                    return None
                ntg = dict(tg)
                ntg["TargetGroupArn"] = dr_tg
                tgs.append(ntg)
            fc["TargetGroups"] = tgs
            na["ForwardConfig"] = fc
        out.append(na)
    return out


def ensure_listeners_in_dr(
    cfg: Config,
    prod_elb,
    dr_elb,
    prod_lb_arn: str,
    dr_lb_arn: str,
    prod_to_dr_tg_arn: Dict[str, str],
    dry_run: bool,
    report: Dict[str, Any],
):
    """
    Create missing listeners in DR to match prod listeners (best-effort).
    - If listener requires cert and cert_map missing => skip that listener (report it).
    - If default action points to TG w/o mapping => skip that listener (report it).
    """
    prod_listeners = list_listeners(prod_elb, prod_lb_arn)
    dr_listeners = list_listeners(dr_elb, dr_lb_arn)

    dr_listener_keys = {(l.get("Protocol"), l.get("Port")) for l in dr_listeners}

    for pl in prod_listeners:
        proto = pl.get("Protocol")
        port = pl.get("Port")
        key = (proto, port)

        if key in dr_listener_keys:
            rep_log(report, "load_balancers", "Listener already exists in DR (skip)",
                    {"action": "skip", "reason": "exists", "protocol": proto, "port": port, "dr_lb_arn": dr_lb_arn})
            continue

        create_args: Dict[str, Any] = {
            "LoadBalancerArn": dr_lb_arn,
            "Protocol": proto,
            "Port": port,
        }

        # Certificates (HTTPS/TLS)
        certs = pl.get("Certificates") or []
        if certs:
            mapped = []
            for c in certs:
                prod_cert_arn = c.get("CertificateArn")
                if not prod_cert_arn:
                    continue
                dr_cert = cfg.cert_map.get(prod_cert_arn)
                if not dr_cert:
                    rep_log(report, "warnings", "Skipping listener: certificate mapping missing",
                            {"prod_cert_arn": prod_cert_arn, "protocol": proto, "port": port})
                    mapped = None
                    break
                mapped.append({"CertificateArn": dr_cert})
            if mapped is None:
                rep_log(report, "load_balancers", "Skip listener due to missing cert_map",
                        {"action": "skip", "protocol": proto, "port": port, "reason": "missing_cert_map"})
                continue
            if mapped:
                create_args["Certificates"] = mapped

        # SSL Policy if present
        if pl.get("SslPolicy"):
            create_args["SslPolicy"] = pl["SslPolicy"]

        # Default actions (must have)
        actions = normalize_actions_for_dr(pl.get("DefaultActions") or [], prod_to_dr_tg_arn)
        if not actions:
            rep_log(report, "warnings", "Skipping listener: cannot map default actions (missing TG mapping?)",
                    {"protocol": proto, "port": port})
            rep_log(report, "load_balancers", "Skip listener due to action mapping failure",
                    {"action": "skip", "protocol": proto, "port": port, "reason": "action_mapping_failed"})
            continue
        create_args["DefaultActions"] = actions

        rep_log(report, "load_balancers", "Create DR listener",
                {"action": "create_listener", "protocol": proto, "port": port, "dry_run": dry_run})

        if dry_run:
            continue

        try:
            dr_elb.create_listener(**create_args)
        except ClientError as e:
            rep_log(report, "errors", "Failed to create listener",
                    {"protocol": proto, "port": port, "error": str(e)})


